{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "hotfix/**": false,
      "revert/**": false,
      "chore/**": false,
      "docs/**": false,
      "ci/**": false,
      "cursor/**": false,
      "claude/**": false,
      "codex/**": false,
      "github/**": false
    }
  },
  "crons": [
    {
      "path": "/api/audit/reconcile",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/sitemap-health",
      "schedule": "17 * * * *"
    }
  ]
}

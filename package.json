{
  "name": "blank",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" pnpm db:clear-dev-push && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 next dev",
    "db:ping": "cross-env NODE_OPTIONS=--no-deprecation node scripts/ping-db.mjs",
    "db:backup": "cross-env NODE_OPTIONS=--no-deprecation node scripts/backup-db.mjs",
    "db:clear-dev-push": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/clear-payload-dev-push.ts",
    "db:migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate",
    "db:fix-portfolio-hero-mobile": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-hero-mobile.ts",
    "db:fix-portfolio-subtitle": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-subtitle.ts",
    "db:fix-portfolio-richtext": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-richtext.ts",
    "db:fix-site-settings-page-heroes": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-site-settings-page-heroes.ts",
    "db:fix-solution-feature-columns": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-solution-feature-columns.ts",
    "db:fix-localization-audit": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 tsx scripts/fix-localization-audit.ts",
    "db:fix-audit-he-copy": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 tsx scripts/patch-audit-he-copy.ts",
    "db:fix-audit-pricing": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 tsx scripts/patch-audit-pricing.ts",
    "db:fix-smart-card-solution": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 tsx scripts/patch-smart-card-solution.ts",
    "db:fix-contact-submissions-audit-fields": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-contact-submissions-audit-fields.ts",
    "db:fix-users-reset-password-requested-at": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-users-reset-password-requested-at.ts",
    "db:fix-contact-submissions-audit-pipeline": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-contact-submissions-audit-pipeline.ts",
    "db:fix-contact-submissions-html-result": "node scripts/fix-contact-submissions-html-result.mjs",
    "media:migrate-blob-to-r2": "node scripts/migrate-blob-media-to-r2.mjs",
    "import:project": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-project/import-project.ts",
    "revalidate:site": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-project/revalidate-site.ts",
    "cf:contact-rate-limit": "node scripts/cloudflare-contact-rate-limit.mjs",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 next dev",
    "clean:dev": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DISABLE_PUSH=1 next dev -p 3003",
    "test:visual": "node check-ui.js",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:ci": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.69",
    "@aws-sdk/client-s3": "3.1146.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.100",
    "border-beam": "^1.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.12",
    "liquid-gooey": "^0.2.1",
    "next": "15.5.27",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "10.0.15",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "pg": "^8.22.0",
    "postcss": "8.5.29",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next": "15"
      }
    },
    "overrides": {
      "browserslist": "4.29.3",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "dompurify": "3.4.16",
      "fast-copy": "3.1.0",
      "fast-uri": "3.1.8",
      "immutable": "4.3.9",
      "js-yaml": "4.3.2",
      "postcss": "8.5.29",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici@6": "6.29.0",
      "undici@7": "7.30.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}

{
  "name": "blank",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" pnpm db:clear-dev-push && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "db:backup": "cross-env NODE_OPTIONS=--no-deprecation node scripts/backup-db.mjs",
    "db:clear-dev-push": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/clear-payload-dev-push.ts",
    "db:migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate",
    "db:fix-portfolio-hero-mobile": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-hero-mobile.ts",
    "db:fix-portfolio-subtitle": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-subtitle.ts",
    "db:fix-portfolio-richtext": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-portfolio-richtext.ts",
    "db:fix-site-settings-page-heroes": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-site-settings-page-heroes.ts",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "clean:dev": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3003",
    "test:visual": "node check-ui.js",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:ci": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-vercel-blob": "^3.85.1",
    "@payloadcms/ui": "^3.85.1",
    "@vercel/analytics": "^2.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "next": "~15.4.11",
    "nextjs-toploader": "^3.9.17",
    "payload": "^3.85.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}

# Translater service (VPS). Never commit the real file.

# Shared with Vercel's CONSULT_TRANSLATE_SECRET. Requests without a matching
# HMAC signature are rejected with 401.
CONSULT_TRANSLATE_SECRET=

# The pipeline calls Gemini itself; use the consultant key or a separate one so
# chat traffic cannot exhaust the QA_Auditor funnel-review quota.
GEMINI_API_KEY=

PORT=8090
TRANSLATER_AGENT_DIR=/app/agent

# PostgreSQL connection string (e.g. Supabase, Neon, or local database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/erythro_db

# Unique cryptographic salt for Payload CMS session encryption
PAYLOAD_SECRET=YOUR_SECRET_CRYPTOGRAPHIC_SALT_HERE

# Secret token for Vercel On-Demand Revalidation (matching n8n hooks)
REVALIDATION_TOKEN=YOUR_REVALIDATION_TOKEN_HERE

# Optional: Blob store id (the `xxxxx` in `xxxxx.public.blob.vercel-storage.com`).
# Needed in the browser to rewrite `/api/media/file/...` → direct Blob URLs
# (admin Media preview). Server can also derive it from BLOB_READ_WRITE_TOKEN.
# NEXT_PUBLIC_BLOB_STORE_ID=

# Contact form mail. Sent FROM Hostinger order@erythro.ai.
# Recipients come from Site Settings → Contacts (notifyEmailContact / notifyEmailOrder).
# On Vercel set the mailbox password (hPanel → Emails → order@erythro.ai):
SMTP_PASS=
# Defaults (override only if Hostinger changes servers):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=order@erythro.ai
# CONTACT_FROM_EMAIL=Erythro.ai <order@erythro.ai>
# Optional fallback inbox only if CMS notify fields are empty:
# CONTACT_NOTIFY_EMAIL=order@erythro.ai
# Rate limit for POST /api/contact (per IP, in-memory per isolate):
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=60000
# Edge rate limit (optional ops only — pnpm cf:contact-rate-limit):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Cloudflare Turnstile (contact / audit / order). Sitekey is public; secret is server-only.
# Dashboard widget domains must include localhost (dev) and erythro.ai (prod).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Alias accepted locally / in next.config: TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Alias accepted: TURNSTILE_SECRET_KEY=
# Prod hostname allowlist — do not include localhost:
# TURNSTILE_HOSTNAMES=erythro.ai,www.erythro.ai

# Cloudflare R2 — AI Audit report objects (S3-compatible). Never commit real keys.
# Account ID is the subdomain of …r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=erythro-audit-reports
# Optional public/custom domain base for reportUrl:
# R2_PUBLIC_BASE_URL=

# Cloudflare R2 — Payload media (bucket erythro-media). Requires a public base
# (r2.dev or custom domain). When set, Payload uses @payloadcms/storage-s3 instead of Blob.
# R2_MEDIA_BUCKET=erythro-media
# R2_MEDIA_PUBLIC_BASE_URL=https://pub-bca1ac764c56451890e973c90029a977.r2.dev
# NEXT_PUBLIC_R2_MEDIA_BASE_URL=https://pub-bca1ac764c56451890e973c90029a977.r2.dev
# NEXT_PUBLIC_R2_MEDIA_HOST=pub-bca1ac764c56451890e973c90029a977.r2.dev

# VPS audit worker (POST /api/run-audit after source=audit contact create)
# AGENT_SECRET_TOKEN=
# AUDIT_AGENT_URL=https://agent-api.erythro.ai
# AUDIT_AGENT_TIMEOUT_MS=8000
# Optional: reject worker calls that omit x-agent-signature HMAC
# AGENT_REQUIRE_HMAC=1

# PayPlus hosted page for paid audits (ILS, one-time J4).
# All three are required before /order can redirect to PayPlus. Until then the
# paid button returns "payment unavailable" and does not create an unpaid order.
# Sandbox: PAYPLUS_TEST_MODE=true (uses restapidev when PAYPLUS_API_URL is empty).
# PAYPLUS_API_KEY=
# PAYPLUS_SECRET_KEY=
# PAYPLUS_PAYMENT_PAGE_UID=
# PAYPLUS_TEST_MODE=true
# PAYPLUS_API_URL=https://restapidev.payplus.co.il/api/v1.0
# Set only after the invoice module is enabled on the payment page. Omit to keep
# the dashboard default (sending the flag when the module is off fails the link).
# PAYPLUS_ISSUE_INVOICE=1
# Optional catalog product. A free-text item name creates a new PayPlus product
# on every charge, so leave this empty unless you have a product UID.
# PAYPLUS_PRODUCT_UID=
# Callback: https://erythro.ai/api/payment/webhook (GET and POST).
# In the PayPlus page, set the success/failure redirect method to GET.
# Connect checklist: docs/architecture/payplus-audit-checkout.md


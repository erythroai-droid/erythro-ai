{
  "rules": [
    {
      "id": "payload-admin-client-uploads",
      "allowed": {
        "origins": [
          "https://erythro.ai",
          "https://www.erythro.ai",
          "http://localhost:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "Content-Length"]
      },
      "exposeHeaders": ["ETag", "Content-Length"],
      "maxAgeSeconds": 3600
    }
  ]
}
